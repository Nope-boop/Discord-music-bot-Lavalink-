# Discord bot credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN= "Bot Token"
# Optional: set this to a guild ID while developing for instant slash-command updates.
# Leave blank to register commands globally (takes up to 1 hour to propagate).
GUILD_ID= "GUILD ID"

# Lavalink node connection (see README for how to get/run one)
LAVALINK_HOST= "Host (Format- IP:Port)
LAVALINK_PASSWORD= "Your choice of pass"
LAVALINK_SECURE=false
PREFIX=!